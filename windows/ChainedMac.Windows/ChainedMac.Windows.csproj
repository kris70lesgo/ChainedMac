<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\ChainedMac.ico</ApplicationIcon>
    <Version>1.0.8</Version>
    <AssemblyName>ChainedMac</AssemblyName>
    <RootNamespace>ChainedMac.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ChainedMacMark.png" />
    <Resource Include="Assets\ChainedMac.ico" />
  </ItemGroup>
</Project>
