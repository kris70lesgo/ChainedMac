<Application x:Class="ChainedMac.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Paper" Color="#F4F3ED" />
    <SolidColorBrush x:Key="Ink" Color="#1E2923" />
    <SolidColorBrush x:Key="Muted" Color="#53635A" />
    <SolidColorBrush x:Key="Purple" Color="#5B21B6" />
    <SolidColorBrush x:Key="Orange" Color="#E75A31" />
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D7D9CF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
