<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\ChainYourMac.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyName>ChainYourMac</AssemblyName>
    <RootNamespace>ChainYourMac.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ChainYourMacMark.png" />
    <Resource Include="Assets\ChainYourMac.ico" />
  </ItemGroup>
</Project>
