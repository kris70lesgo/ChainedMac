<Window x:Class="ChainYourMac.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChainYourMac" Width="390" Height="700" MinHeight="600" MaxHeight="820"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}"
        Icon="Assets/ChainYourMac.ico" ShowInTaskbar="True" Closing="Window_Closing">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <Grid Margin="0,0,0,15">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Source="Assets/ChainYourMacMark.png" Width="24" Height="32" Stretch="Uniform" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="CHAIN YOUR MAC" FontSize="12" FontWeight="Bold" />
          <TextBlock x:Name="WindowSummary" Text="Your workspace, in a line" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="2" Content="Settings" Style="{StaticResource ActionButton}" Padding="9,6" Click="Settings_Click" />
      </Grid>

      <Border x:Name="QuickStartCard" Background="#FFFFFF" BorderBrush="#E0E1DA" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,14">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBlock Text="QUICK START" FontSize="10" FontWeight="Bold" />
            <Button DockPanel.Dock="Right" Content="Done" Padding="5,1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Purple}" FontSize="10" Click="DismissQuickStart_Click" />
          </DockPanel>
          <TextBlock Text="1  Leave the windows you want to arrange open." FontSize="10" Margin="0,3" TextWrapping="Wrap" />
          <TextBlock Text="2  Choose Arrange open windows." FontSize="10" Margin="0,3" TextWrapping="Wrap" />
          <TextBlock Text="3  Use Shift+← / → to focus; Ctrl+Alt+R restores their positions." FontSize="10" Margin="0,3" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border x:Name="MainPanel">
        <StackPanel>
          <Button x:Name="ArrangeButton" Content="Arrange open windows" Background="{StaticResource Orange}" Foreground="White" BorderThickness="0" Padding="14,12" FontSize="13" FontWeight="Bold" Click="Arrange_Click" />

          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="←  Previous   ⇧←" Style="{StaticResource ActionButton}" Click="Previous_Click" />
            <Button Grid.Column="2" Content="Next   ⇧→  →" Style="{StaticResource ActionButton}" Click="Next_Click" />
          </Grid>

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="↔  Widen" Style="{StaticResource ActionButton}" Click="Widen_Click" />
            <Button Grid.Column="2" Content="⌖  Center" Style="{StaticResource ActionButton}" Click="Center_Click" />
          </Grid>

          <Button x:Name="RestoreButton" Content="Restore original positions   Ctrl+Alt+R" Style="{StaticResource ActionButton}" Margin="0,8,0,0" Click="Restore_Click" Visibility="Collapsed" />

          <TextBlock x:Name="StatusMessage" Text="Ready to arrange your windows." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,13,0,0" MinHeight="28" />
          <TextBlock x:Name="ShortcutStatus" Text="Checking shortcuts…" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />

          <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E0E1DA" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,13,0,0">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" />
                <Button DockPanel.Dock="Right" Content="Hide" Padding="5,1" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Purple}" FontSize="10" Click="Settings_Click" />
              </DockPanel>
              <DockPanel>
                <TextBlock Text="STRIP GAP" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="GapValue" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Muted}" />
              </DockPanel>
              <Slider x:Name="GapSlider" Minimum="0" Maximum="80" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="GapSlider_ValueChanged" Margin="0,2,0,10" />
              <TextBlock Text="GLOBAL SHORTCUTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,3,0,4" />
              <TextBlock Text="Focus previous     Shift+Left" FontSize="10" Margin="0,2" />
              <TextBlock Text="Focus next            Shift+Right" FontSize="10" Margin="0,2" />
              <TextBlock Text="Restore positions   Ctrl+Alt+R" FontSize="10" Margin="0,2" />
              <Button Content="Show quick start" HorizontalAlignment="Left" Padding="5,2" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Purple}" FontSize="10" Click="ShowQuickStart_Click" />
            </StackPanel>
          </Border>

          <DockPanel Margin="0,16,0,0">
            <TextBlock Text="WIN 11 / 10 LTSC · VERSION 1.0" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Quit" Padding="8,3" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="10" Click="Quit_Click" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
